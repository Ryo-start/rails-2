<%= form_for @user, url: profile_update_path do |f| %>
  <% if @user.errors.any? %>
    <div class="alert alert-danger">
      <ul>
        <% @user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= f.label :username, "名前" %>
    <%= f.text_field :username, class: "form-control"%>
  </div>

  <div class="form-group">
    <%= f.label :profile, "自己紹介" %>
    <%= f.text_area :profile, class: "form-control" %>
  </div>

  <div class="field">
  <%= f.label :avata, "アイコン画像" %>
  <%= f.file_field :avatar %>
  </div>

  <div class="form-group">
    <%= f.submit "プロフィール更新", class: "btn btn-primary" %>
  </div>
<% end %>

<% if @user.avatar? %>  
  <p>
    <strong>Avatar:</strong>
    <%= image_tag @user.avatar.url %><!-- userインスタンスの画像ファイルのURLを取得し表示 -->
  </p>
<% end %>
