<%= form_for @user, url: profile_update_path do |f| %>
  <% if @user.errors.any? %>
    <div class="alert alert-danger">
      <ul>
        <% @user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <section class="FormContainer">
    <div class="form-group">
      <%= f.label :username, "名前", class: "h4 font-weight-bold" %>
      <%= f.text_field :username, class: "form-control form-control-lg" %>
    </div>

    <div class="form-group">
      <%= f.label :profile, "自己紹介", class: "h4 font-weight-bold" %>
      <%= f.text_area :profile, class: "form-control form-control-lg" %>
    </div>

    <div class="form-group">
      <%= f.label :avatar, "アイコン画像", class: "h4 font-weight-bold" %>
      <%= f.file_field :avatar, class: "form-control-lg form-control-file" %>
    </div>

    <div class="text-center mt-4 form-group">
      <%= f.submit "プロフィール更新", class: "btn-lg" %>
    </div>

    <% if @user.avatar? %>
      <p>
        <strong>Avatar:</strong>
        <%= image_tag @user.avatar.url %> <!-- userインスタンスの画像ファイルのURLを取得し表示 -->
      </p>
    <% end %>
  </section>
<% end %>
