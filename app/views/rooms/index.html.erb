<h1>部屋一覧</h1>


<% if @rooms && @rooms.any? %>
  <% @rooms.each do |room| %>
    <div>
      <% if room.image.attached? %>
        <%= image_tag room.image, style: "width: 100px; height: auto;" %>
      <% end %>

      <h2>施設名: <%= link_to room.name, room %></h2>
      <p>紹介文: <%= room.details %></p>
      <p>宿泊料金（/日）: <%= number_to_currency(room.price, unit: '¥', precision: 0) %></p>
      <p>作成日: <%= room.created_at.strftime("%Y年%m月%d日 %H:%M") %></p>

      <%= link_to '編集', edit_room_path(room) %>
      <%= link_to '削除', room_path(room), method: :delete, data: { confirm: '本当に削除しますか？' } %>
    </div>
  <% end %>
<% else %>
  <p>部屋がありません。</p>
<% end %>


<%= form_with url: search_rooms_path, method: :get, local: true do %>
  <input type="text" name="area" id="area" value="<%= params[:area] %>" placeholder="エリア名を入力">
  <input type="text" name="q" placeholder="キーワード名を入力" value="<%= params[:q] %>">
  <button type="submit">検索</button>
<% end %>
