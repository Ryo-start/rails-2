<h1>新しい部屋を作成</h1>

<%= form_with model: @room, local: true do |form| %>
  <div>
    <%= form.label :name, "施設名" %>
    <%= form.text_field :name, required: true %>
  </div>

  <div>
    <%= form.label :details, "施設詳細" %>
    <%= form.text_area :details, required: true %>
  </div>

  <div>
    <%= form.label :price, "料金" %>
    <%= form.number_field :price, step: 1, required: true %>
  </div>

  <div>
    <%= form.label :address, "住所" %>
    <%= form.text_area :address, required: true %>
  </div>

  <div>
    <%= form.label :image, "部屋画像" %>
    <%= form.file_field :image %>
  </div>

  <div>
    <%= form.submit "作成" %>
  </div>
<% end %>

