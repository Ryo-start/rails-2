<section class="FormContainer">
  <h1 class="text-center mb-5">新しい部屋を作成</h1>

  <%= form_with model: @room, local: true do |form| %>

    <div class="form-group">
      <%= form.label :name, "施設名", class: "h4 font-weight-bold" %>
      <%= form.text_field :name, class: "form-control form-control-lg", required: true, placeholder: "施設名を入力" %>
    </div>

    <div class="form-group">
      <%= form.label :details, "施設詳細", class: "h4 font-weight-bold" %>
      <%= form.text_area :details, class: "form-control form-control-lg", required: true, placeholder: "施設の詳細を入力" %>
    </div>

    <div class="form-group">
      <%= form.label :price, "料金", class: "h4 font-weight-bold" %>
      <%= form.number_field :price, class: "form-control form-control-lg", step: 1, required: true, placeholder: "料金を入力" %>
    </div>

    <div class="form-group">
      <%= form.label :address, "住所", class: "h4 font-weight-bold" %>
      <%= form.text_area :address, class: "form-control form-control-lg", required: true, placeholder: "住所を入力" %>
    </div>

    <div class="form-group">
      <%= form.label :image, "部屋画像", class: "h4 font-weight-bold" %>
      <%= form.file_field :image, class: "form-control-lg form-control-file" %>
    </div>

    <div class="text-center mt-4 form-group">
      <%= form.submit "登録", class: "btn-lg" %>
    </div>
</section>

<% end %>
