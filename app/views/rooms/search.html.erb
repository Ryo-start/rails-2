<h1>検索結果</h1>

<% if @total_rooms > 0 %>
  <p>検索結果: <%= @total_rooms %> 件</p>
  
  <% @rooms.each do |room| %>
    <div>
      <h2><%= link_to room.name, room %></h2>
      <p><strong>住所:</strong> <%= room.address %></p>
      <p><strong>施設詳細:</strong> <%= room.details %></p>
      <p><strong>宿泊料金（/日）:</strong> ¥<%= number_to_currency(room.price, unit: '', precision: 0) %></p>
    </div>
  <% end %>

<% else %>
  <p>該当する施設がありません。</p>
<% end %>
