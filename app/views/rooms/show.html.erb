<h1><%= @room.name %>の詳細</h1>

<% if @room.image.attached? %>
  <p><strong>部屋画像:</strong></p>
  <%= image_tag @room.image, style: "width: 100px; height: auto;" %>
<% else %>
  <p>画像はありません</p>
<% end %>
<p><strong>施設名 :</strong> <%= @room.name %></p>
<p><strong>紹介文 :</strong> <%= @room.details %></p>
<p><strong>宿泊料金（/日） :</strong> <%= number_to_currency(@room.price, unit: '¥', precision: 0) %></p>



<%= link_to '編集', edit_room_path(@room) %>
<%= link_to '戻る', rooms_path %>

<%= link_to '予約する', new_room_reservation_path(@room), class: 'btn btn-primary' %>
