<h1>予約確認</h1>

<p><strong>チェックイン日:</strong> <%= @reservation.check_in_date.strftime("%Y/%m/%d") %></p>
<p><strong>チェックアウト日:</strong> <%= @reservation.check_out_date.strftime("%Y/%m/%d") %></p>
<p><strong>宿泊日数:</strong> <%= @reservation.nights %> 泊</p>
<p><strong>人数:</strong> <%= @reservation.guest_count %> 名</p>
<p><strong>支払い金額:</strong> <%= number_to_currency(@reservation.total_price, unit: "¥", precision: 0) %></p>

<%= button_to "予約を確定する", confirm_room_reservation_path(@reservation.room, @reservation), method: :patch, class: "btn btn-primary" %>
<%= link_to '戻る', new_room_reservation_path(@reservation.room) %>




