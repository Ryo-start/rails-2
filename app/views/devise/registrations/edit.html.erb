<section class="FormContainer">
  <h1 class="text-center mb-5">アカウント</h1>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>

  <div class="form-group">
    <%= f.label :メールアドレス, class: "h4 font-weight-bold" %><br />
    <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control-lg form-control-file" %>
  </div>

  <div class="form-group">
    <%= f.label :パスワード, class: "h4 font-weight-bold" %> <br />
    <%= f.password_field :password, autocomplete: "new-password", class: "form-control-lg form-control-file" %>
  </div>

  <div class="form-group">
    <%= f.label :確認用パスワード, class: "h4 font-weight-bold" %><br />
    <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control-lg form-control-file" %>
  </div>

  <div class="form-group">
    <%= f.label :現在のパスワード, class: "h4 font-weight-bold" %> <br />
    <%= f.password_field :current_password, autocomplete: "current-password" , class: "form-control-lg form-control-file" %>
  </div>

  <div class="text-center mt-4 form-group">
    <%= f.submit "更新" , class: "btn-lg" %>
  </div>
<% end %>

<div class="mt-4 form-group" style="text-align: center;">
<%= link_to "キャンセル", :back, class: "btn-lg" %>
</div>

</section>



